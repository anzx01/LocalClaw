{
  "name": "weather",
  "version": "2.0.0",
  "description": "Get current weather and forecasts via wttr.in API. Use when user asks about weather, temperature, or forecasts for any location.",
  "type": "workflow",
  "inputs": {
    "location": "string",
    "format": "string",
    "days": "integer"
  },
  "outputs": {
    "weather": "string",
    "location": "string",
    "temperature": "string",
    "condition": "string"
  },
  "actions": [
    {
      "type": "tool_call",
      "name": "get_weather",
      "tool": "http_get",
      "params": {
        "url": "https://wttr.in/${location}?format=j1"
      },
      "timeout": 10
    },
    {
      "type": "transform",
      "name": "format_weather",
      "template": "天气查询结果：${weather_result}"
    }
  ],
  "permissions": {
    "risk_level": "low"
  },
  "triggers": [
    {
      "type": "intent",
      "pattern": "check_weather"
    },
    {
      "type": "intent",
      "pattern": "get_weather"
    },
    {
      "type": "pattern",
      "pattern": "^(?:今天|明天|后天).*?(?:天气|下雨|下雪|晴)"
    },
    {
      "type": "pattern",
      "pattern": "^(?:天气|下雨|下雪|晴)"
    },
    {
      "type": "pattern",
      "pattern": "^(?:what|how).*?(?:weather|temperature)"
    }
  ]
}
