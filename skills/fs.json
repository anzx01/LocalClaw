{
  "name": "fs",
  "version": "2.0.0",
  "description": "完整的文件系统操作，包括创建、读取、更新、删除文件和目录",
  "type": "workflow",
  "inputs": {
    "action": "string",
    "path": "string",
    "content": "string",
    "mode": "string",
    "recursive": "boolean",
    "parents": "boolean",
    "all": "boolean",
    "long": "boolean"
  },
  "outputs": {
    "result": "string",
    "data": "object"
  },
  "actions": [
    {
      "type": "tool_call",
      "name": "file_read",
      "condition": "{{action == 'read'}}",
      "inputs": {
        "path": "{{path}}"
      },
      "outputs": {
        "result": "{{content}}",
        "data": {"path": "{{path}}"}
      }
    },
    {
      "type": "tool_call",
      "name": "file_write",
      "condition": "{{action == 'write'}}",
      "inputs": {
        "path": "{{path}}",
        "content": "{{content}}",
        "mode": "{{mode}}"
      },
      "outputs": {
        "result": "File written successfully",
        "data": {"path": "{{path}}"}
      }
    },
    {
      "type": "tool_call",
      "name": "file_append",
      "condition": "{{action == 'append'}}",
      "inputs": {
        "path": "{{path}}",
        "content": "{{content}}"
      },
      "outputs": {
        "result": "Content appended successfully",
        "data": {"path": "{{path}}"}
      }
    },
    {
      "type": "tool_call",
      "name": "file_delete",
      "condition": "{{action == 'delete'}}",
      "inputs": {
        "path": "{{path}}",
        "recursive": "{{recursive}}"
      },
      "outputs": {
        "result": "File deleted successfully",
        "data": {"path": "{{path}}"}
      }
    },
    {
      "type": "tool_call",
      "name": "file_mkdir",
      "condition": "{{action == 'mkdir'}}",
      "inputs": {
        "path": "{{path}}",
        "parents": "{{parents}}"
      },
      "outputs": {
        "result": "Directory created successfully",
        "data": {"path": "{{path}}"}
      }
    },
    {
      "type": "tool_call",
      "name": "file_list",
      "condition": "{{action == 'list'}}",
      "inputs": {
        "path": "{{path}}",
        "all": "{{all}}",
        "long": "{{long}}"
      },
      "outputs": {
        "result": "Directory listed successfully",
        "data": {"files": "{{files}}", "directories": "{{directories}}", "details": "{{details}}"}
      }
    }
  ],
  "permissions": {
    "risk_level": "low"
  },
  "triggers": [
    {
      "type": "pattern",
      "pattern": "^fs\\s+(read|write|append|delete|mkdir|list)\\s+(.+)$"
    },
    {
      "type": "pattern",
      "pattern": "^创建文件\\s+(.+)$"
    },
    {
      "type": "pattern",
      "pattern": "^新建文件\\s+(.+)$"
    },
    {
      "type": "pattern",
      "pattern": "^写入文件\\s+(.+)\\s+内容\\s+(.+)$"
    },
    {
      "type": "pattern",
      "pattern": "^读取文件\\s+(.+)$"
    },
    {
      "type": "pattern",
      "pattern": "^删除文件\\s+(.+)$"
    },
    {
      "type": "pattern",
      "pattern": "^删除目录\\s+(.+)$"
    },
    {
      "type": "pattern",
      "pattern": "^创建目录\\s+(.+)$"
    },
    {
      "type": "pattern",
      "pattern": "^新建目录\\s+(.+)$"
    },
    {
      "type": "pattern",
      "pattern": "^列出目录\\s+(.+)$"
    },
    {
      "type": "pattern",
      "pattern": "^查看目录\\s+(.+)$"
    }
  ]
}
