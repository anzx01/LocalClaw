{
  "name": "web_search",
  "version": "1.0.0",
  "description": "Search the web using DuckDuckGo API. Use when user asks questions that require current information, facts, or web content.",
  "type": "workflow",
  "inputs": {
    "query": "string",
    "limit": "integer"
  },
  "outputs": {
    "results": "list",
    "query": "string"
  },
  "actions": [
    {
      "type": "tool_call",
      "name": "search_web",
      "tool": "http_get",
      "params": {
        "url": "https://api.duckduckgo.com/?q=${query}&format=json&no_html=1"
      },
      "timeout": 15
    }
  ],
  "permissions": {
    "risk_level": "low"
  },
  "triggers": [
    {
      "type": "intent",
      "pattern": "web_search"
    },
    {
      "type": "intent",
      "pattern": "search"
    },
    {
      "type": "pattern",
      "pattern": "^(?:搜索|查找|查询|search).*"
    },
    {
      "type": "pattern",
      "pattern": "^(?:帮我|请).*?(?:搜|查|找)"
    },
    {
      "type": "pattern",
      "pattern": "^.*?(?:是什么|是什么意思|怎么样|如何)"
    }
  ]
}
