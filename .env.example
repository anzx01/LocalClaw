# LocalClaw Configuration
# Copy this file to .env and modify as needed

# Execution mode: zero | local | hybrid
LOCALCLAW_MODE=local

# Enable LLM integration (set to true for local/hybrid mode)
LOCALCLAW_LLM_ENABLED=true

# Local-first model provider configuration
LOCALCLAW_MODEL_PROVIDER=ollama
LOCALCLAW_MODEL_NAME=qwen2.5-coder:7b
LOCALCLAW_MODEL_API=openai-compatible
LOCALCLAW_MODEL_CONTEXT_WINDOW=32768
# LOCALCLAW_MODEL_BASE_URL=http://127.0.0.1:11434/v1

# Bundled skill directory
LOCALCLAW_SKILLS_DIR=./skills

# User-managed and workspace skill directories
# LOCALCLAW_MANAGED_SKILLS_DIR=%USERPROFILE%/.localclaw/skills
# LOCALCLAW_WORKSPACE_SKILLS_DIR=./skills
# LOCALCLAW_EXTRA_SKILL_DIRS=["D:/shared-skills","D:/team-skills"]

# Directory for data storage
LOCALCLAW_DATA_DIR=./data

# Path to memory database
LOCALCLAW_MEMORY_DB=./data/memory.db

# Path to audit log
LOCALCLAW_AUDIT_LOG=./data/audit.jsonl

# Logging level
LOCALCLAW_LOG_LEVEL=INFO

# Server configuration
LOCALCLAW_SERVER_HOST=127.0.0.1
LOCALCLAW_SERVER_PORT=8000

# Default timeout for operations (seconds)
LOCALCLAW_DEFAULT_TIMEOUT=30.0

# Maximum retry attempts
LOCALCLAW_MAX_RETRIES=3

# Retry delay (seconds)
LOCALCLAW_RETRY_DELAY=1.0

# Ollama configuration (for local mode)
# LOCALCLAW_OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenAI-compatible configuration (for local or hybrid mode)
# LOCALCLAW_OPENAI_API_KEY=your-api-key
# LOCALCLAW_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
