# LocalClaw Configuration
# Copy this file to .env and modify as needed

# Execution mode: zero | local | hybrid
LOCALCLAW_MODE=zero

# Enable LLM integration (set to true for local/hybrid mode)
LOCALCLAW_LLM_ENABLED=false

# Directory for skill definitions
LOCALCLAW_SKILLS_DIR=./skills

# Directory for data storage
LOCALCLAW_DATA_DIR=./data

# Path to memory database
LOCALCLAW_MEMORY_DB=./data/memory.db

# Path to audit log
LOCALCLAW_AUDIT_LOG=./data/audit.jsonl

# Logging level
LOCALCLAW_LOG_LEVEL=INFO

# Server configuration
LOCALCLAW_SERVER_HOST=127.0.0.1
LOCALCLAW_SERVER_PORT=8000

# Default timeout for operations (seconds)
LOCALCLAW_DEFAULT_TIMEOUT=30.0

# Maximum retry attempts
LOCALCLAW_MAX_RETRIES=3

# Retry delay (seconds)
LOCALCLAW_RETRY_DELAY=1.0

# Ollama configuration (for local mode)
# LOCALCLAW_OLLAMA_BASE_URL=http://localhost:11434

# OpenAI configuration (for hybrid mode)
# LOCALCLAW_OPENAI_API_KEY=your-api-key
# LOCALCLAW_OPENAI_BASE_URL=https://api.openai.com/v1
