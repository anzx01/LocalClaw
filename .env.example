# LocalClaw Configuration
# Copy this file to .env and modify as needed

# Execution mode: zero | local | hybrid
LOCALCLAW_MODE=local

# Enable the default local-model understanding flow.
# Setting this to false no longer falls back to the old parser chain in normal product mode.
LOCALCLAW_LLM_ENABLED=true

# Route all user input through the local LLM understanding chain
LOCALCLAW_LLM_PARSE_ONLY=true

# Local-first model provider configuration
LOCALCLAW_MODEL_PROVIDER=ollama
LOCALCLAW_MODEL_NAME=qwen3:4b
LOCALCLAW_MODEL_API=ollama
LOCALCLAW_MODEL_CONTEXT_WINDOW=32768
# LOCALCLAW_MODEL_BASE_URL=http://127.0.0.1:11434/v1

# Bundled skill directory
LOCALCLAW_SKILLS_DIR=./skills

# User-managed and workspace skill directories
# LOCALCLAW_MANAGED_SKILLS_DIR=%USERPROFILE%/.localclaw/skills
# LOCALCLAW_WORKSPACE_SKILLS_DIR=./skills
# LOCALCLAW_EXTRA_SKILL_DIRS=["D:/shared-skills","D:/team-skills"]

# Third-party skill protection
# off | disable_high_risk | isolate
LOCALCLAW_SKILL_INSTALL_PROTECTION_MODE=disable_high_risk
# In isolate mode, protected tools require manual approval before execution
LOCALCLAW_SKILL_ISOLATION_REQUIRE_APPROVAL=true
# In isolate mode, still block critical tools such as raw shell execution
LOCALCLAW_SKILL_ISOLATION_BLOCK_CRITICAL=true

# Directory for data storage
LOCALCLAW_DATA_DIR=./data

# Path to memory database
LOCALCLAW_MEMORY_DB=./data/memory.db

# Path to audit log
LOCALCLAW_AUDIT_LOG=./data/audit.jsonl

# Logging level
LOCALCLAW_LOG_LEVEL=INFO

# Server configuration
LOCALCLAW_SERVER_HOST=127.0.0.1
LOCALCLAW_SERVER_PORT=8000

# Default timeout for operations (seconds)
LOCALCLAW_DEFAULT_TIMEOUT=30.0

# Maximum retry attempts
LOCALCLAW_MAX_RETRIES=3

# Retry delay (seconds)
LOCALCLAW_RETRY_DELAY=1.0

# Ollama configuration (for local mode)
# LOCALCLAW_OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenAI-compatible configuration (for local or hybrid mode)
# LOCALCLAW_OPENAI_API_KEY=your-api-key
# LOCALCLAW_OPENAI_BASE_URL=http://127.0.0.1:1234/v1

# Experimental personal WeChat bridge
# LOCALCLAW_WECHAT_PERSONAL_ENABLED=true
# LOCALCLAW_WECHAT_PERSONAL_INBOUND_TOKEN=shared-secret-from-bridge
# LOCALCLAW_WECHAT_PERSONAL_PROXY_URL=https://your-bridge.example/api/reply
# LOCALCLAW_WECHAT_PERSONAL_API_KEY=bridge-api-key
# LOCALCLAW_WECHAT_PERSONAL_REPLY_VIA_PROXY=false

# WhatsApp Cloud API
# LOCALCLAW_WHATSAPP_ENABLED=true
# LOCALCLAW_WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
# LOCALCLAW_WHATSAPP_APP_SECRET=your-meta-app-secret
# LOCALCLAW_WHATSAPP_ACCESS_TOKEN=your-system-user-access-token
# LOCALCLAW_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# LOCALCLAW_WHATSAPP_GRAPH_API_VERSION=v23.0
# LOCALCLAW_WHATSAPP_REPLY_VIA_CLOUD_API=false
